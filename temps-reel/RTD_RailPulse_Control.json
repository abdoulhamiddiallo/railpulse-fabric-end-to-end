    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"Trains\"] = count()",
      "id": "2cb0cb0e-0aba-5599-a6d5-9e11fa6ca30e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"Retard moyen (min)\"] = round(avg(delay_min), 1)",
      "id": "9a7abb92-b857-54af-827f-b4f706942ba7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"Trains\"] = countif(delay_min > 15)",
      "id": "e65aee8a-ca8e-5c67-bb0a-d2f4759fb4ee",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"km/h\"] = round(avg(speed_kmh), 0)",
      "id": "d3adb2c4-a2e3-5343-839a-195fc1bcb6d4",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"Voyageurs\"] = sum(passengers)",
      "id": "2c1d23e0-8b06-5745-9f53-df3a2874c6be",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "print [\"Heure\"] = iff(now() - RailClock() < 2m, \"EN DIRECT\", format_datetime(datetime_utc_to_local(RailClock(), \"Europe/Paris\"), \"HH:mm\"))",
      "id": "115fbac8-74fd-546a-a95f-e20fab678e59",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | project latitude, longitude, Train = strcat(train_id, \" · \", line_code, \" · \", delay_min, \" min\"), [\"Retard (min)\"] = delay_min",
      "id": "9a7d711b-d69f-50f7-9f43-8d7110d8125e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | where delay_min > 5 | order by delay_min desc | project Train = train_id, Ligne = line_code, Relation = relation, [\"Retard (min)\"] = delay_min, [\"Vitesse (km/h)\"] = speed_kmh, Avancement = strcat(round(progress_pct, 0), \" %\"), [\"État\"] = etat",
      "id": "f6e66dee-7db6-5435-a7c6-580dceec22cf",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveWindow(30) | summarize [\"Retard moyen (min)\"] = round(avg(delay_min), 1) by Minute = bin(ts, 1m), Ligne = line_code | order by Minute asc",
      "id": "14de8919-d1b7-5ed0-91db-985ec41a98cf",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize [\"Retard moyen (min)\"] = round(avg(delay_min), 1) by Ligne = line_code | order by [\"Retard moyen (min)\"] desc",
      "id": "1e8dec29-401d-55bc-a18b-69bb3c564224",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveNetworkLatest() | summarize Trains = count() by [\"État\"] = etat",
      "id": "24d91bad-ffda-58fd-97ab-27297916dabb",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5515560d-1501-4811-a02a-056033d4413e"
      },
      "text": "LiveWindow(10) | where speed_kmh < 20 and progress_pct between (5.0 .. 95.0) | summarize arg_max(ts, *) by train_id | project [\"Heure\"] = format_datetime(datetime_utc_to_local(ts, \"Europe/Paris\"), \"HH:mm:ss\"), Train = train_id, Ligne = line_code, Relation = strcat(origin, \" > \", destination), [\"Vitesse (km/h)\"] = speed_kmh, [\"Retard (min)\"] = delay_min, Latitude = round(latitude, 4), Longitude = round(longitude, 4) | order by [\"Retard (min)\"] desc",
