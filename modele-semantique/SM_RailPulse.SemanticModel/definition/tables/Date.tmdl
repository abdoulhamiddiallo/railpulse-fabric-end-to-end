/// Calendrier du 01/10/2025 au 31/12/2026
table Date
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column Date
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: date

	column Année
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column 'N° mois'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_num

	column 'Nom du mois'
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'N° mois'

	column Année-mois
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: year_month

	column 'N° jour'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: weekday_num

	column Jour
		dataType: string
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: 'N° jour'

	column Week-end
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	partition Date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DatabaseQuery

