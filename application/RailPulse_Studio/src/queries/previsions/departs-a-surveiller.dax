// Les 50 départs prévus au retard le plus élevé.
EVALUATE
CALCULATETABLE(
    TOPN(
        50,
        SELECTCOLUMNS(
            'Prévision',
            "Départ prévu", 'Prévision'[Départ prévu],
            "Relation", RELATED('Relation'[Relation]),
            "Ligne", RELATED('Relation'[Ligne]),
            "Rame", RELATED('Rame'[Rame]),
            "Sévérité météo", 'Prévision'[Sévérité météo],
            "Remplissage prévu", 'Prévision'[Remplissage prévu],
            "Retard prévu (min)", 'Prévision'[Retard prévu (min)],
            "Niveau de risque", 'Prévision'[Niveau de risque]
        ),
        [Retard prévu (min)], DESC,
        [Départ prévu], ASC
    )
    /*,FILTRE_RELATION*/
)
ORDER BY [Retard prévu (min)] DESC, [Départ prévu]
